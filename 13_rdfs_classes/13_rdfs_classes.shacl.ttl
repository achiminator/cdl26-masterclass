@prefix ex: <http://example.com/FriendGraph#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:adventureBookShape a sh:NodeShape ;
    sh:targetNode ex:AdventureBook ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:message "AdventureBook is not a subclass of Book" ;
        sh:minCount 1 ;
        ] .
        
ex:bookShape a sh:NodeShape ;
    sh:targetNode ex:Book ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:message "Book is not a subclass of Publication" ;
        sh:minCount 1 ;
        ] .
        
ex:sailingAroundTheWorldShape a sh:NodeShape ;
    sh:targetNode ex:sailingAroundTheWorld ;
    sh:property [
        sh:path rdf:type ;
        sh:message "sailingAroundTheWorld is not of type Publication and Book" ;
        sh:value ex:Book, ex:Publication
        ] .