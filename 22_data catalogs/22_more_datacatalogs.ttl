@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/> .

ex:catalog-2026 a dcat:Catalog ;
	dct:title "Example Data Catalog"@en ;
	dct:description "A small DCAT example catalog for tutorial purposes."@en ;
	dct:publisher ex:org-neonto ;
	dct:issued "2026-11-11"^^xsd:date ;
	dcat:dataset ex:dataset-sales-q1 .

ex:dataset-sales-q1 a dcat:Dataset ;
	dct:title "Q1 Sales Data"@en ;
	dct:description "Quarter 1 sales figures by region."@en ;
	dct:keyword "sales", "region", "quarterly" ;
	dct:license <https://creativecommons.org/licenses/by/4.0/> ;
	dcat:distribution ex:dist-sales-q1-csv .

ex:dist-sales-q1-csv a dcat:Distribution ;
	dct:title "Q1 Sales CSV"@en ;
	dcat:downloadURL <https://example.org/data/q1-sales.csv> ;
	dcat:mediaType "text/csv" .

ex:org-neonto a foaf:Organization ;
	foaf:name "NEOnto" .
